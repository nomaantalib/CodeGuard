# CodeGuard Configuration (.env)
# CodeGuard automatically loads this file if present in the project or current directory.

# Primary free/local setup with Ollama:
# CodeGuard dynamically auto-selects whichever Ollama coding model is downloaded locally
# (e.g. qwen2.5-coder:1.5b, qwen2.5-coder:3b, etc.).
# You can also explicitly pin your preferred model below or pass --model to the CLI.
CODEGUARD_LLM_PROVIDER=ollama
CODEGUARD_MODEL=qwen2.5-coder:1.5b
CODEGUARD_LLM_URL=http://localhost:11434

# Optional remote OpenAI-compatible provider (may have free-tier limits)
# CODEGUARD_LLM_PROVIDER=openai-compatible
# CODEGUARD_MODEL=Qwen/Qwen2.5-Coder-7B-Instruct
# CODEGUARD_LLM_URL=https://your-provider.example/v1
# CODEGUARD_LLM_API_KEY=

# Optional paid Anthropic provider
# CODEGUARD_LLM_PROVIDER=anthropic
# CODEGUARD_MODEL=claude-model-name
# CODEGUARD_LLM_URL=https://api.anthropic.com/v1/messages
# ANTHROPIC_API_KEY=

# --- server / SaaS mode ---
CODEGUARD_DATA=./codeguard-data
CODEGUARD_ADMIN_TOKEN=
STRIPE_WEBHOOK_SECRET=
CODEGUARD_SANDBOX=docker
CODEGUARD_ALLOW_UNSAFE_LOCAL=0
